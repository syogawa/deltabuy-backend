generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id        BigInt    @id @default(autoincrement())
  name      String
  avatar    String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  deletedAt DateTime? @map("deleted_at")
  role      Role      @default(USER)
}
