// Дефолт настройки можно не трогать
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

//тип базы данных
datasource db {
  provider = "postgresql"
}

//Описание возможных ролей пользователей
enum Role {
  USER
  ADMIN
  MODERATOR
}

//Описание возможных валют
enum Currency {
  USD
  RUB
  EUR
}

//Описание статусов сделки
enum DealStatus {
  PAID
  REFUNDED
  COMPLETED
}


//Таблица пользователя
model User {
  id             Int            @id @default(autoincrement())                      //Первичный ключ
  name           String                                                           //Имя пользователя
  avatar         String?                                                            //URL Аватар пользователя
  email          String         @unique                                                //Email пользователя
  description    String?                                                               //Описание
  password       String                                                                //Пароль пользователя в хэшированном виде
  createdAt      DateTime       @default(now()) @map("created_at")                    //Дата создания пользователя
  deletedAt      DateTime?      @map("deleted_at")                                    //Дата удаления пользователя возможнен null
  isActive       Boolean        @map("is_active") @default(true)                      //Статус аккаунта удален ли он или активен
  role           Role           @default(USER)                                      //Роль пользователя по умолчанию USER
  //Связи с другими таблицами Many to Many
  deals          Deal[]                                                             //Список сделок пользователя
  sessions       Session[]                                                              //Список сессий пользователя
  oAuth          Oauth[]                                                                 //Список OAuth провайдеров пользователя
  viewedProducts ProductViews[]                                                           //Список просмотренных продуктов
  favorite       Favorite[]                                                             //Список избранных продуктов
  basket         Basket[]
  reviews        Review[]
  

  products Product[] @relation("SellerProducts")
}

model Product {
  id                Int               @id @default(autoincrement())
  name              String                                                                        //Название продукта
  description       String?                                                                        //Описание продукта
  price             Decimal           @db.Decimal(10, 2)                                          //Цена продукта
  salePrice         Decimal?          @db.Decimal(10, 2) @map("sale_price")                       //Цена продукта по скидке
  sellerId          Int               @map("seller_id")                                            //Айди продавца
  quantity          Int               @default(1)                                                   //Количество
  currency          Currency          @default(RUB)                                                //Валюта цены по умолчанию RUB
  createdAt         DateTime          @default(now()) @map("created_at")                           //Дата создания продукта
  updatedAt         DateTime?         @updatedAt @map("updated_at")                               //Дата обновления продукта   возможен null
  deletedAt         DateTime?         @map("deleted_at")                                          //Дата удаления продукта   возможен null
  isActive          Boolean           @default(true) @map("is_active")                              //Статус активности продукта
  hidden            Boolean           @default(false)                                               //Отображается ли продукт самому владельцу (для мягких удалений)
  
  seller User @relation("SellerProducts", fields: [sellerId], references: [id])
  //Связи с другими таблицами Many to Many
  deals             Deal[]                                  //Список сделок продукта           
  productImages     productImage[]                           //Список изображений продукта 
  viewedProducts    ProductViews[]                           //Список пользователей, которые просмотрели продукт
  favorite          Favorite[]                              //Список пользователей, которые добавили продукт в избранное
  productCategories ProductCategory[]                      //Список категорий, к которым относится продукт
  basket            Basket[]
  reviews           Review[]
}

model Deal {
  id        Int        @id @default(autoincrement())
  buyerId   Int        @map("buyer_id")
  productId Int        @map("product_id")
  status    DealStatus @default(PAID)
  createdAt DateTime   @default(now()) @map("created_at")
  deletedAt DateTime?  @map("deleted_at")

  // Товар на момент покупки
  quantity        Int                                          // сколько штук куплено
  priceAtPurchase Decimal  @db.Decimal(10, 2) @map("price_at_purchase") // цена за штуку, которую реально заплатили
  currency        Currency                                     // валюта на момент покупки
  productSnapshot Json     @map("product_snapshot")            // name, description, картинки, категории и т.д.

  buyer   User    @relation(fields: [buyerId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  
  reviews   Review[]
  @@index([buyerId])
  @@index([productId])
}

model Session {
  id                Int        @id @default(autoincrement())             //первичный ключ айди
  userId            Int        @map("user_id")                           //внешний ключ юзер айди
  refreshTokenHash  String     @unique @map("refresh_token")             //рефреш токен hash
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now()) @map("created_at")        // когда создана сессия
  expiresAt         DateTime   @map("expires_at")                        //когда закончится refresh токен
  lastUsedAt        DateTime   @map("last_used") @updatedAt              //когда последний раз была использована сессия
  //Связи с другими таблицами Many to Many
  user User @relation(fields: [userId], references: [id])  
}

model Oauth {
  id         Int      @id @default(autoincrement())       //первичный ключ айди
  userId     Int      @map("user_id")                     //внешний ключ юзер айди
  provider   String                                       //название привявзанной соцсети
  providerId String   @map("provider_id")                 //айди привязанной соцсети
  createdAt  DateTime @default(now()) @map("created_at")  //когда создана привязка
  //Связи с другими таблицами Many to Many
  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId]) //на одного провайдера существует только один айдишник
  @@unique([userId, provider])    //к одному юзеру может привязан быть только один провайдер
}

model productImage {
  id        Int    @id @default(autoincrement())  //первичный ключ айди
  productId Int    @map("product_id")             //айди продукта  внешний ключ
  url       String                                //дорога до изображения
  position  Int    @default(0)                    //позиция изображения
  //Связи с другими таблицами Many to Many
  product Product @relation(fields: [productId], references: [id])
  //название таблицы в базе данных
  @@map("product_image")
}

model Category {
  id                Int               @id @default(autoincrement()) // первичный ключ
  name              String                                             // название категории
  parentId          Int?              @map("parent_id")               // id родительской категории (null = корневая)
  createdAt         DateTime          @default(now()) @map("created_at") // дата создания
  updatedAt         DateTime?         @updatedAt @map("updated_at")   // дата последнего обновления
  deletedAt         DateTime?         @map("deleted_at")              // дата мягкого удаления (null = активна)
  hidden            Boolean           @default(false)
  // Связи
  productCategories ProductCategory[]                                 // many-to-many с товарами
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  @@index([id, hidden])
  @@index([parentId, hidden])
}

model ProductViews {
  id        Int      @id @default(autoincrement()) // первичный ключ
  userId    Int      @map("user_id")               // id пользователя, который просмотрел
  productId Int      @map("product_id")            // id просмотренного товара
  viewedAt  DateTime @default(now()) @map("viewed_at") // дата и время просмотра

  // Связи
  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("product_views") // название таблицы в БД
  @@unique([userId, productId])
}

model Favorite {
  id        Int      @id @default(autoincrement()) // первичный ключ
  userId    Int      @map("user_id")               // id пользователя
  productId Int      @map("product_id")            // id товара в избранном
  createdAt DateTime @default(now()) @map("created_at") // дата добавления в избранное
  updatedAt DateTime? @map("updated_at") @updatedAt
  hidden    Boolean  @default(false)               //мягкое удаление из избранных
  // Связи
  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId, hidden])
}

model ProductCategory {
  productId  Int @map("product_id")  // id товара
  categoryId Int @map("category_id") // id категории

  // Связи many-to-many
  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId]) // составной первичный ключ
  @@map("product_category")     // название таблицы в БД
}

model Basket {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)            //Количество
  hidden    Boolean  @default(false)        //Отоброжается ли или нет
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId, hidden])
  @@unique([userId, productId])
  @@map("basket")
}

model Review {
  id          Int           @id @default(autoincrement())
  dealId      Int           @unique                                                    // один отзыв на одну покупку
  authorId    Int           @map("author_id")                                                          // покупатель (дублируем для быстрых выборок)
  productId   Int           @map("product_id")                                            // для списка отзывов на товар
  rating      Int                                                                      // 1..5
  text        String?
  hidden      Boolean       @default(false)                                            // мягкое удаление, как в корзине
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt      @map("updated_at")

  deal        Deal          @relation(fields: [dealId], references: [id])
  user    User    @relation(fields: [authorId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@index([productId, hidden])
  @@index([authorId])
}